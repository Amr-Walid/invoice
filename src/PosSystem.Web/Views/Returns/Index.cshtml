@model PosSystem.Web.Models.ViewModels.ReturnSearchVm
@{
    ViewData["Title"] = "مرتجع";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <h1 class="page-title mb-0">
        <i class="bi bi-arrow-counterclockwise"></i> مرتجع
    </h1>
    <a class="btn btn-outline-secondary" asp-action="List">
        <i class="bi bi-list-ul"></i> سجل المرتجعات
    </a>
</div>

@*
    خطوة 1 من 3. نوضّح الخطوات صراحةً لأن الإرجاع عملية مالية عكسية، ومن
    المهم أن يعرف المستخدم أين هو وأن التأكيد لم يحدث بعد.
*@
<div class="steps mb-3">
    <span class="step active"><span class="step-num">1</span> ابحث عن الفاتورة</span>
    <span class="step"><span class="step-num">2</span> حدّد الأصناف المُرجَعة</span>
    <span class="step"><span class="step-num">3</span> اضغط «تم»</span>
</div>

<form class="filter-bar" method="get" asp-action="Index">
    <div class="row g-2 align-items-end">
        <div class="col-12 col-md-7">
            <label class="form-label">
                رقم الفاتورة أو رقم هاتف العميل
            </label>
            <input type="text" name="q" class="form-control form-control-lg" value="@Model.Query"
                   placeholder="مثال: INV-20260804-0001 أو 01001234567" autofocus />
        </div>
        <div class="col-6 col-md-3">
            <button type="submit" class="btn btn-brand btn-lg w-100">
                <i class="bi bi-search"></i> بحث
            </button>
        </div>
        @if (Model.Searched)
        {
            <div class="col-6 col-md-2">
                <a class="btn btn-outline-secondary btn-lg w-100" asp-action="Index">
                    <i class="bi bi-x-circle"></i> مسح
                </a>
            </div>
        }
    </div>
    <div class="mt-2" style="font-size:.82rem;color:#64748b">
        <i class="bi bi-info-circle"></i>
        يمكنك البحث برقم الهاتف بأي صيغة — الأرقام مرتبطة بالعميل تلقائيًا.
    </div>
</form>

@if (!Model.Searched)
{
    <div class="empty-state card">
        <div class="card-body text-center py-5">
            <i class="bi bi-search" style="font-size:3rem;opacity:.35"></i>
            <p class="mt-3 mb-0 text-muted">
                ابحث عن الفاتورة المطلوب إرجاعها لتبدأ عملية المرتجع
            </p>
        </div>
    </div>
}
else
{
    <div class="table-wrap">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>رقم الفاتورة</th>
                        <th>التاريخ والوقت</th>
                        <th>العميل</th>
                        <th>المندوب</th>
                        <th class="text-center">القطع</th>
                        <th>الإجمالي</th>
                        <th>الحالة</th>
                        <th style="width:150px"></th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Results.Any())
                    {
                        <tr>
                            <td colspan="8" class="empty-state">
                                <i class="bi bi-receipt"></i>
                                لا توجد فاتورة مطابقة — تأكد من رقم الفاتورة أو رقم الهاتف
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var inv in Model.Results)
                        {
                            <tr>
                                <td><strong class="num">@inv.InvoiceNumber</strong></td>
                                <td class="num">@inv.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>
                                    @(string.IsNullOrWhiteSpace(inv.CustomerName) ? "—" : inv.CustomerName)
                                    @if (!string.IsNullOrWhiteSpace(inv.CustomerPhone))
                                    {
                                        <div class="text-muted num" style="font-size:.8rem">@inv.CustomerPhone</div>
                                    }
                                </td>
                                <td>@inv.AgentName</td>
                                <td class="text-center">
                                    <span class="num">@inv.TotalQuantity</span>
                                    @if (inv.ReturnedQuantity > 0)
                                    {
                                        <span class="badge badge-soft-orange num"
                                              title="مُرجَع سابقًا">-@inv.ReturnedQuantity</span>
                                    }
                                </td>
                                <td><strong class="num">@inv.Total.ToString("N2")</strong></td>
                                <td><span class="badge @inv.StatusBadgeClass">@inv.StatusLabel</span></td>
                                <td>
                                    @if (inv.CanReturn)
                                    {
                                        <a class="btn btn-sm btn-warning fw-bold"
                                           asp-action="Create" asp-route-invoiceId="@inv.Id">
                                            <i class="bi bi-arrow-counterclockwise"></i> عمل مرتجع
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted" style="font-size:.82rem">
                                            <i class="bi bi-slash-circle"></i> لا يوجد ما يُرجَع
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
}
