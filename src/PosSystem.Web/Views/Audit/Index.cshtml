@model List<PosSystem.Web.Models.Entities.AuditLog>
@{
    ViewData["Title"] = "سجل العمليات";
    var page = (int)ViewBag.Page;
    var totalPages = (int)ViewBag.TotalPages;
    var actions = ViewBag.Actions as List<string> ?? new List<string>();
    var currentOp = ViewBag.Op as string;
    var currentQ = ViewBag.Q as string;
    var from = ViewBag.From as DateTime?;
    var to = ViewBag.To as DateTime?;
    var hasFilter = !string.IsNullOrWhiteSpace(currentOp) || !string.IsNullOrWhiteSpace(currentQ)
                    || from.HasValue || to.HasValue;

    // نطاق أرقام الصفحات: عرض 400 زر صفحة يُدمّر الصفحة، فنعرض نافذة حول الحالية
    var win = 3;
    var firstPage = Math.Max(1, page - win);
    var lastPage = Math.Min(totalPages, page + win);
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <h1 class="page-title mb-0"><i class="bi bi-shield-check"></i> سجل العمليات</h1>
    <span class="text-muted" style="font-size:.9rem">
        @if (hasFilter)
        {
            <span>نتائج التصفية:</span>
        }
        else
        {
            <span>إجمالي السجلات:</span>
        }
        <strong class="num">@ViewBag.Total</strong>
    </span>
</div>

<form class="filter-bar" method="get" asp-action="Index">
    <div class="row g-2 align-items-end">
        <div class="col-6 col-md-3">
            <label class="form-label">نوع العملية</label>
            <select name="op" class="form-select">
                <option value="">كل العمليات</option>
                @foreach (var a in actions)
                {
                    <option value="@a" selected="@(currentOp == a)">@a</option>
                }
            </select>
        </div>
        <div class="col-6 col-md-3">
            <label class="form-label">بحث</label>
            <input type="text" name="q" class="form-control" value="@currentQ"
                   placeholder="اسم المستخدم أو التفاصيل" />
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label">من تاريخ</label>
            <input type="date" name="from" class="form-control num" dir="ltr"
                   value="@(from?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label">إلى تاريخ</label>
            <input type="date" name="to" class="form-control num" dir="ltr"
                   value="@(to?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="col-12 col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-brand flex-grow-1">
                <i class="bi bi-funnel"></i> تصفية
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary" title="إلغاء التصفية">
                <i class="bi bi-x-lg"></i>
            </a>
        </div>
    </div>
</form>

<div class="table-wrap">
    <div class="table-responsive">
        <table class="table table-hover mb-0" id="auditTable">
            <thead>
                <tr>
                    <th style="width:150px">التاريخ والوقت</th>
                    <th style="width:160px">المستخدم</th>
                    <th style="width:130px">العملية</th>
                    <th style="width:110px">الكيان</th>
                    <th>التفاصيل</th>
                    <th style="width:120px">IP</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="empty-state">
                            <i class="bi bi-shield-check"></i>
                            @(hasFilter ? "لا توجد سجلات مطابقة للتصفية" : "لا توجد سجلات")
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var log in Model)
                    {
                        <tr>
                            <td class="num" style="font-size:.85rem">@log.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td class="fw-semibold">@log.UserName</td>
                            <td>
                                @{
                                    var cls = log.Action switch
                                    {
                                        PosSystem.Web.Models.Entities.AuditActions.Sale => "badge-soft-green",
                                        PosSystem.Web.Models.Entities.AuditActions.Delete => "badge-soft-red",
                                        PosSystem.Web.Models.Entities.AuditActions.Create => "badge-soft-blue",
                                        PosSystem.Web.Models.Entities.AuditActions.Update => "badge-soft-orange",
                                        PosSystem.Web.Models.Entities.AuditActions.PrintBarcode => "badge-soft-purple",
                                        _ => "badge-soft-gray"
                                    };
                                }
                                <span class="badge @cls">@log.Action</span>
                            </td>
                            <td class="text-muted" style="font-size:.85rem">@log.EntityName</td>
                            <td style="font-size:.86rem">@log.Details</td>
                            <td class="num text-muted" style="font-size:.8rem">@log.IpAddress</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@if (totalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination justify-content-center flex-wrap">
            @* asp-route-op لا asp-route-action: مفتاح "action" محجوز في التوجيه ويُفسد الرابط *@
            <li class="page-item @(page == 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-op="@currentOp" asp-route-q="@currentQ"
                   asp-route-from="@(from?.ToString("yyyy-MM-dd"))" asp-route-to="@(to?.ToString("yyyy-MM-dd"))"
                   asp-route-page="1" title="الأولى">&laquo;</a>
            </li>
            @for (var p = firstPage; p <= lastPage; p++)
            {
                <li class="page-item @(p == page ? "active" : "")">
                    <a class="page-link num" asp-action="Index" asp-route-op="@currentOp" asp-route-q="@currentQ"
                       asp-route-from="@(from?.ToString("yyyy-MM-dd"))" asp-route-to="@(to?.ToString("yyyy-MM-dd"))"
                       asp-route-page="@p">@p</a>
                </li>
            }
            <li class="page-item @(page == totalPages ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-op="@currentOp" asp-route-q="@currentQ"
                   asp-route-from="@(from?.ToString("yyyy-MM-dd"))" asp-route-to="@(to?.ToString("yyyy-MM-dd"))"
                   asp-route-page="@totalPages" title="الأخيرة">&raquo;</a>
            </li>
        </ul>
        <p class="text-center text-muted" style="font-size:.82rem">
            @* لا نكتب ‎@page‎ مباشرة: Razor يحجز هذا الاسم كتوجيه صفحة *@
            صفحة <span class="num">@(page)</span> من <span class="num">@totalPages</span>
        </p>
    </nav>
}

<p class="text-muted mt-2" style="font-size:.84rem">
    <i class="bi bi-info-circle"></i>
    السجل <strong>للقراءة فقط</strong> ولا يمكن تعديله أو حذفه من الواجهة، ليصلح كدليل تدقيق موثوق.
    يُسجَّل تلقائيًا: تسجيل الدخول والخروج، البيع، وكل إضافة/تعديل/حذف للمنتجات والبراندات
    والتصنيفات والكوبونات والمستخدمين، وطباعة ملصقات الباركود.
</p>
