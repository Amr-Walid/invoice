@model PosSystem.Web.Models.Entities.Product
@{
    ViewData["Title"] = "منتج جديد";
}

<h1 class="page-title"><i class="bi bi-plus-circle"></i> إضافة منتج جديد</h1>

<div class="card">
    <div class="card-body">
        <form asp-action="Create" method="post">
            @await Html.PartialAsync("_ProductForm", Model)

            <hr class="my-4">
            <button type="submit" class="btn btn-brand touch-btn px-4">
                <i class="bi bi-check-lg"></i> حفظ المنتج
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary touch-btn px-4">إلغاء</a>
        </form>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script src="~/js/product-form.js" asp-append-version="true"></script>
}
