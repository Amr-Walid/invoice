@model PosSystem.Web.Models.Entities.Product
@using Microsoft.AspNetCore.Mvc.Rendering
@*
    نموذج مشترك بين الإضافة والتعديل.
    قائمة التصنيفات تُحدَّث ديناميكيًا عند تغيير البراند (AJAX).
*@

<div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3"></div>

<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" placeholder="مثال: Infinix Note 40 Pro" autofocus />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Barcode" class="form-label"></label>
        <input asp-for="Barcode" class="form-control num" dir="ltr" placeholder="6941238701234" />
        <span asp-validation-for="Barcode" class="text-danger"></span>
        <small class="text-muted">يمكنك مسح الباركود بالجهاز مباشرة في هذا الحقل</small>
    </div>

    <div class="col-md-6">
        <label asp-for="BrandId" class="form-label"></label>
        <select asp-for="BrandId" class="form-select" asp-items="ViewBag.Brands" id="brandSelect">
            <option value="">— اختر البراند —</option>
        </select>
        <span asp-validation-for="BrandId" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="CategoryId" class="form-label"></label>
        <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.Categories" id="categorySelect">
            <option value="">— اختر التصنيف —</option>
        </select>
        <span asp-validation-for="CategoryId" class="text-danger"></span>
        <small class="text-muted">التصنيفات تتغير حسب البراند المختار</small>
    </div>

    <div class="col-md-4">
        <label asp-for="Price" class="form-label"></label>
        <input asp-for="Price" class="form-control num" dir="ltr" type="number" step="0.01" min="0.01" />
        <span asp-validation-for="Price" class="text-danger"></span>
        <small class="text-muted">السعر المعروض في الفاتورة</small>
    </div>

    @{
        var isNew = Model.Id == 0;
        var warehouses = ViewBag.Warehouses as IEnumerable<SelectListItem>;
    }

    <div class="col-md-4">
        <label asp-for="StockQuantity" class="form-label">
            @(isNew ? "الكمية الافتتاحية" : "إجمالي الكمية (كل المخازن)")
        </label>
        @if (isNew)
        {
            <input asp-for="StockQuantity" class="form-control num" dir="ltr" type="number" min="0" />
            <span asp-validation-for="StockQuantity" class="text-danger"></span>
            <small class="text-muted">تُودَع في المخزن المختار كرصيد افتتاحي</small>
        }
        else
        {
            @* للقراءة فقط: الرقم مجموع مخازن متعددة، وتعديله من حقل واحد
               لا يُعرِّف من أي مخزن يُخصم الفرق. التعديل من شاشة المخزن. *@
            <input asp-for="StockQuantity" class="form-control num" dir="ltr"
                   type="number" readonly />
            <span asp-validation-for="StockQuantity" class="text-danger"></span>
            <small class="text-muted">
                للتعديل استخدم
                <a asp-controller="Warehouses" asp-action="Index">مخزون المخازن</a>
            </small>
        }
    </div>

    @if (isNew && warehouses is not null)
    {
        <div class="col-md-4">
            <label for="OpeningWarehouseId" class="form-label">مخزن الرصيد الافتتاحي</label>
            <select name="OpeningWarehouseId" id="OpeningWarehouseId"
                    class="form-select" asp-items="warehouses"></select>
            <small class="text-muted">أين تُوضع الكمية الافتتاحية فعليًا</small>
        </div>
    }

    <div class="col-md-4">
        <label asp-for="LowStockThreshold" class="form-label"></label>
        <input asp-for="LowStockThreshold" class="form-control num" dir="ltr" type="number" min="0" />
        <span asp-validation-for="LowStockThreshold" class="text-danger"></span>
        <small class="text-muted">حد التنبيه العام — يمكن تخصيصه لكل مخزن</small>
    </div>

    <div class="col-md-4 d-flex align-items-center">
        <div class="form-check mt-4">
            <input asp-for="IsActive" class="form-check-input" />
            <label asp-for="IsActive" class="form-check-label">مفعل (متاح للبيع)</label>
        </div>
    </div>
</div>

@* ملاحظة: سكربت تحديث التصنيفات موجود في Create.cshtml و Edit.cshtml
   لأن الـ sections لا يمكن تعريفها داخل partial في Razor *@
