@model List<PosSystem.Web.Models.Entities.StockTransfer>
@using PosSystem.Web.Models.Entities
@{
    var w = (Warehouse)ViewBag.Warehouse;
    ViewData["Title"] = "طلبات واردة للاعتماد";
    var canSwitch = (bool)(ViewBag.CanSwitch ?? false);

    var pending = Model.Count(t => t.CanDecide);
    var toShip = Model.Count(t => t.CanShip);
    var outInTransit = Model.Where(t => t.Status == TransferStatus.Shipped).Sum(t => t.TotalInTransit);
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <h1 class="page-title mb-0">
        <i class="bi bi-inbox"></i> طلبات واردة على «@w.Name»
    </h1>
    <div class="d-flex gap-2 flex-wrap">
        <a class="btn btn-outline-secondary touch-btn" asp-action="Index"
           asp-route-warehouseId="@(canSwitch ? w.Id.ToString() : null)">
            <i class="bi bi-arrow-left-right"></i> طلباتي
        </a>
        <a class="btn btn-outline-primary touch-btn" asp-action="InTransit">
            <i class="bi bi-truck"></i> في الطريق
        </a>
    </div>
</div>

<p class="text-muted">
    مخازن أخرى تطلب قطعًا من مخزنك. الموافقة لا تُخرج القطع — الخروج والخصم
    يحدثان عند <b>الشحن</b> بالكميات التي تحددها فعلًا.
</p>

@if (pending > 0 || toShip > 0)
{
    <div class="alert alert-info d-flex align-items-center gap-2">
        <i class="bi bi-bell fs-4"></i>
        <div>
            @if (pending > 0)
            {
                <span><b class="num">@pending</b> طلب ينتظر قرارك. </span>
            }
            @if (toShip > 0)
            {
                <span><b class="num">@toShip</b> طلب معتمد ينتظر الشحن.</span>
            }
        </div>
    </div>
}

<div class="row g-3 mb-3">
    <div class="col-6 col-lg-3">
        <div class="card"><div class="card-body py-3">
            <div class="text-muted small">إجمالي الواردة</div>
            <div class="fs-4 fw-bold num">@Model.Count</div>
        </div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card"><div class="card-body py-3">
            <div class="text-muted small">تنتظر قرارك</div>
            <div class="fs-4 fw-bold num @(pending > 0 ? "text-warning" : "")">@pending</div>
        </div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card"><div class="card-body py-3">
            <div class="text-muted small">معتمدة تنتظر الشحن</div>
            <div class="fs-4 fw-bold num @(toShip > 0 ? "text-primary" : "")">@toShip</div>
        </div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card"><div class="card-body py-3">
            <div class="text-muted small">قطع خرجت ولم تُستلم</div>
            <div class="fs-4 fw-bold num">@outInTransit</div>
        </div></div>
    </div>
</div>

@await Html.PartialAsync("_TransferFilter", new ViewDataDictionary(ViewData) { ["FilterAction"] = "Incoming" })

@await Html.PartialAsync("_TransferTable", Model, new ViewDataDictionary(ViewData)
{
    ["Mode"] = "incoming",
    ["EmptyText"] = "لا توجد طلبات واردة على مخزنك"
})
