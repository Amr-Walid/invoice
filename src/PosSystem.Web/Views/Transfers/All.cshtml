@model List<PosSystem.Web.Models.Entities.StockTransfer>
@using PosSystem.Web.Models.Entities
@{
    ViewData["Title"] = "سجل التحويلات";
    var current = ViewBag.Status as TransferStatus?;
    var statuses = new[]
    {
        TransferStatus.Pending, TransferStatus.Approved, TransferStatus.Shipped,
        TransferStatus.Received, TransferStatus.Rejected, TransferStatus.Cancelled
    };
    var inTransit = Model.Sum(t => t.TotalInTransit);
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <h1 class="page-title mb-0"><i class="bi bi-clock-history"></i> سجل التحويلات</h1>
    <a class="btn btn-outline-primary touch-btn" asp-action="InTransit">
        <i class="bi bi-truck"></i> في الطريق
    </a>
</div>

<p class="text-muted">
    كل حركات النقل بين المخازن (أحدث ٣٠٠ طلب). كل تحويل هنا له أثره الكامل في
    «كارت الصنف» بمخزنيه: خصم عند الشحن وإضافة عند الاستلام.
</p>

<div class="row g-3 mb-3">
    <div class="col-6 col-lg-3">
        <div class="card"><div class="card-body py-3">
            <div class="text-muted small">عدد التحويلات</div>
            <div class="fs-4 fw-bold num">@Model.Count</div>
        </div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card"><div class="card-body py-3">
            <div class="text-muted small">مكتملة</div>
            <div class="fs-4 fw-bold num text-success">
                @Model.Count(t => t.Status == TransferStatus.Received)
            </div>
        </div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card"><div class="card-body py-3">
            <div class="text-muted small">مرفوضة أو ملغاة</div>
            <div class="fs-4 fw-bold num">
                @Model.Count(t => t.Status is TransferStatus.Rejected or TransferStatus.Cancelled)
            </div>
        </div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card"><div class="card-body py-3">
            <div class="text-muted small">قطع في الطريق</div>
            <div class="fs-4 fw-bold num @(inTransit > 0 ? "text-primary" : "")">@inTransit</div>
        </div></div>
    </div>
</div>

<form method="get" class="row g-2 align-items-end mb-3">
    <div class="col-md-4">
        <label class="form-label">الحالة</label>
        <select name="status" class="form-select" onchange="this.form.submit()">
            <option value="">— كل الحالات —</option>
            @foreach (var s in statuses)
            {
                <option value="@((int)s)" selected="@(current == s)">@TransferStatusLabel.Of(s)</option>
            }
        </select>
    </div>
    <div class="col-md-4">
        <button type="submit" class="btn btn-outline-secondary touch-btn">
            <i class="bi bi-funnel"></i> تصفية
        </button>
        @if (current is not null)
        {
            <a class="btn btn-link" asp-action="All">إلغاء التصفية</a>
        }
    </div>
</form>

@await Html.PartialAsync("_TransferTable", Model, new ViewDataDictionary(ViewData)
{
    ["Mode"] = "all",
    ["EmptyText"] = "لا توجد تحويلات مسجّلة"
})
