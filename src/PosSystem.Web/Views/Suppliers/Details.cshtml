@model PosSystem.Web.Models.ViewModels.SupplierStatementVm
@using PosSystem.Web.Models.Entities
@{
    var s = Model.Supplier;
    ViewData["Title"] = $"كشف حساب — {s.Name}";
    var canManage = (bool)(ViewBag.CanManage ?? false);
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <h1 class="page-title mb-0">
        <i class="bi bi-receipt"></i> @s.Name
        @if (!s.IsActive)
        {
            <span class="badge badge-soft-gray">معطَّل</span>
        }
    </h1>
    <div class="d-flex gap-2 flex-wrap">
        @if (canManage)
        {
            <a class="btn btn-brand touch-btn" asp-controller="Purchases" asp-action="Create">
                <i class="bi bi-cart-plus"></i> أمر شراء جديد
            </a>
            <a class="btn btn-outline-primary touch-btn" asp-action="Edit" asp-route-id="@s.Id">
                <i class="bi bi-pencil"></i> تعديل البيانات
            </a>
        }
        <a class="btn btn-outline-secondary touch-btn" asp-action="Index">
            <i class="bi bi-arrow-right"></i> الموردون
        </a>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-header"><i class="bi bi-person-badge"></i> بيانات المورد</div>
            <div class="card-body">
                <dl class="row mb-0 small">
                    <dt class="col-5 text-muted">الهاتف</dt>
                    <dd class="col-7 num" dir="ltr">@s.Phone</dd>

                    <dt class="col-5 text-muted">مسؤول التواصل</dt>
                    <dd class="col-7">@(string.IsNullOrWhiteSpace(s.ContactPerson) ? "—" : s.ContactPerson)</dd>

                    <dt class="col-5 text-muted">البريد</dt>
                    <dd class="col-7" dir="ltr">@(string.IsNullOrWhiteSpace(s.Email) ? "—" : s.Email)</dd>

                    <dt class="col-5 text-muted">العنوان</dt>
                    <dd class="col-7">@(string.IsNullOrWhiteSpace(s.Address) ? "—" : s.Address)</dd>

                    <dt class="col-5 text-muted">مسجَّل منذ</dt>
                    <dd class="col-7 num">@s.CreatedAt.ToString("yyyy-MM-dd")</dd>
                </dl>

                @if (!string.IsNullOrWhiteSpace(s.Notes))
                {
                    <hr />
                    <div class="small"><span class="text-muted">ملاحظات:</span> @s.Notes</div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="row g-3">
            <div class="col-6 col-md-3">
                <div class="card"><div class="card-body py-3">
                    <div class="text-muted small">إجمالي المشتريات</div>
                    <div class="fs-4 fw-bold num">@Model.TotalPurchased.ToString("N2")</div>
                    <div class="small text-muted">بلا الأوامر الملغاة</div>
                </div></div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card"><div class="card-body py-3">
                    <div class="text-muted small">عدد الأوامر</div>
                    <div class="fs-4 fw-bold num">@Model.OrderCount</div>
                    @if (Model.CancelledCount > 0)
                    {
                        <div class="small text-muted num">+@Model.CancelledCount ملغي</div>
                    }
                </div></div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card"><div class="card-body py-3">
                    <div class="text-muted small">بانتظار التوريد</div>
                    <div class="fs-4 fw-bold num @(Model.OpenOrderCount > 0 ? "text-warning" : "")">
                        @Model.OpenOrderCount
                    </div>
                </div></div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card"><div class="card-body py-3">
                    @* الالتزام القائم: ما وعد به المورد ولم يصل بعد *@
                    <div class="text-muted small">قطع لم تصل</div>
                    <div class="fs-4 fw-bold num @(Model.PiecesPending > 0 ? "text-danger" : "")">
                        @Model.PiecesPending
                    </div>
                    <div class="small text-muted num">
                        من @Model.PiecesOrdered
                    </div>
                </div></div>
            </div>
        </div>

        @if (Model.PiecesPending > 0)
        {
            <div class="alert alert-warning mt-3 mb-0">
                <i class="bi bi-hourglass-split"></i>
                هذا المورد عليه <strong class="num">@Model.PiecesPending</strong> قطعة لم تُورَّد بعد
                في <strong class="num">@Model.OpenOrderCount</strong> أمر مفتوح.
            </div>
        }
    </div>
</div>

<h2 class="section-title"><i class="bi bi-list-ul"></i> أوامر الشراء</h2>

<div class="table-wrap">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th style="width:160px">رقم الأمر</th>
                    <th style="width:120px">التاريخ</th>
                    <th>المخزن المستقبِل</th>
                    <th style="width:100px">الأصناف</th>
                    <th style="width:130px">مستلم / مطلوب</th>
                    <th style="width:130px">الإجمالي</th>
                    <th style="width:170px">الحالة</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Orders.Any())
                {
                    <tr>
                        <td colspan="7" class="empty-state">
                            <i class="bi bi-cart-x"></i> لا توجد أوامر شراء لهذا المورد بعد
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var o in Model.Orders)
                    {
                        var ordered = o.Items.Sum(x => x.Quantity);
                        var received = o.Items.Sum(x => x.ReceivedQuantity);
                        <tr class="@(o.Status == PurchaseStatus.Cancelled ? "table-secondary" : "")">
                            <td>
                                <a asp-controller="Purchases" asp-action="Details" asp-route-id="@o.Id"
                                   class="num fw-bold text-decoration-none">@o.PurchaseNumber</a>
                            </td>
                            <td class="num small">@o.CreatedAt.ToString("yyyy-MM-dd")</td>
                            <td>@(o.Warehouse?.Name ?? "—")</td>
                            <td class="num">@o.Items.Count</td>
                            <td class="num">
                                @* الفرق يُبرز بالأمبر: أمر مفتوح ناقص هو ما يحتاج متابعة *@
                                <span class="@(received < ordered && o.Status != PurchaseStatus.Cancelled ? "text-warning fw-bold" : "")">
                                    @received / @ordered
                                </span>
                            </td>
                            <td class="num fw-bold">@o.Total.ToString("N2")</td>
                            <td>
                                <span class="badge @PurchaseStatusLabel.Badge(o.Status)">
                                    @PurchaseStatusLabel.Of(o.Status)
                                </span>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@if (canManage)
{
    <div class="mt-3 d-flex gap-2 flex-wrap">
        <form asp-action="ToggleActive" asp-route-id="@s.Id" asp-route-returnTo="details"
              method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-@(s.IsActive ? "warning" : "success") touch-btn">
                <i class="bi bi-@(s.IsActive ? "pause" : "play")"></i>
                @(s.IsActive ? "تعطيل المورد" : "تفعيل المورد")
            </button>
        </form>

        @if (Model.Orders.Count == 0)
        {
            <form asp-action="Delete" asp-route-id="@s.Id" method="post" class="d-inline"
                  onsubmit="return confirm('حذف المورد نهائيًا؟');">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-danger touch-btn">
                    <i class="bi bi-trash"></i> حذف المورد
                </button>
            </form>
        }
        else
        {
            @* لا زر حذف أصلًا حين يوجد أمر: عرض زر يُرفض دائمًا إرباك *@
            <span class="text-muted small align-self-center">
                <i class="bi bi-shield-check"></i>
                لا يُحذف مورد له أوامر شراء — استخدم التعطيل
            </span>
        }
    </div>
}
