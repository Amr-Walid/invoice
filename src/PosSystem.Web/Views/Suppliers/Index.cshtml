@model PosSystem.Web.Models.ViewModels.SupplierListVm
@using PosSystem.Web.Models.Entities
@{
    ViewData["Title"] = "الموردون";
    var canManage = (bool)(ViewBag.CanManage ?? false);

    // مبالغ التعامل تُحجب عن غير المدير: عمل أمين المخزن التواصل والاستلام.
    var canSeeCost = (bool)(ViewBag.CanSeeCost ?? false);
    var colCount = canSeeCost ? 10 : 9;
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <h1 class="page-title mb-0"><i class="bi bi-truck"></i> الموردون</h1>
    @if (canManage)
    {
        <a class="btn btn-brand touch-btn" asp-action="Create">
            <i class="bi bi-plus-lg"></i> مورد جديد
        </a>
    }
</div>

@* بطاقتان لا أربع: عدد الموردين وأوامرهم المفتوحة هما ما يُتابَع فعلًا *@
<div class="row g-3 mb-3">
    <div class="col-6 col-lg-3">
        <div class="card"><div class="card-body py-3">
            <div class="text-muted small">إجمالي الموردين</div>
            <div class="fs-4 fw-bold num">@Model.TotalCount</div>
        </div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card"><div class="card-body py-3">
            <div class="text-muted small">أوامر بانتظار التوريد</div>
            @{ var openTotal = Model.Suppliers.Sum(s => s.OpenOrderCount); }
            <div class="fs-4 fw-bold num @(openTotal > 0 ? "text-warning" : "")">@openTotal</div>
        </div></div>
    </div>
    @if (canSeeCost)
    {
        <div class="col-12 col-lg-6">
            <div class="card"><div class="card-body py-3">
                <div class="text-muted small">إجمالي المشتريات من موردي هذه الصفحة</div>
                <div class="fs-4 fw-bold num">@Model.Suppliers.Sum(s => s.TotalPurchased).ToString("N2")</div>
            </div></div>
        </div>
    }
</div>

<div class="card mb-3">
    <div class="card-body py-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-end">
            <div class="col-md-6">
                <label class="form-label small text-muted">بحث بالاسم أو رقم الهاتف</label>
                @* البحث بالرقم يستخدم الصيغة المُوحَّدة، فيجد المورد أيًّا كانت
                   طريقة كتابة رقمه (مسافات، شرطات، أرقام عربية) *@
                <input type="search" name="q" value="@Model.Query" class="form-control"
                       placeholder="اسم المورد، الهاتف، مسؤول التواصل…" />
            </div>
            <div class="col-md-3">
                <div class="form-check mt-4">
                    <input type="checkbox" name="includeInactive" value="true"
                           class="form-check-input" id="incInactive"
                           @(Model.IncludeInactive ? "checked" : "")
                           onchange="this.form.submit()" />
                    <label class="form-check-label" for="incInactive">إظهار المعطَّلين</label>
                </div>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-brand touch-btn w-100">
                    <i class="bi bi-search"></i> بحث
                </button>
            </div>
        </form>
    </div>
</div>

<div class="table-wrap">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th style="width:50px">#</th>
                    <th>اسم المورد</th>
                    <th style="width:140px">الهاتف</th>
                    <th>مسؤول التواصل</th>
                    <th style="width:90px">الأوامر</th>
                    <th style="width:110px">مفتوحة</th>
                    @if (canSeeCost)
                    {
                        <th style="width:130px">إجمالي التعامل</th>
                    }
                    <th style="width:120px">آخر أمر</th>
                    <th style="width:90px">الحالة</th>
                    <th style="width:200px"></th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Suppliers.Any())
                {
                    <tr>
                        <td colspan="@colCount" class="empty-state">
                            <i class="bi bi-truck"></i>
                            @(string.IsNullOrWhiteSpace(Model.Query)
                                ? "لا يوجد موردون — ابدأ بإضافة مورد قبل تسجيل أول أمر شراء"
                                : "لا نتائج مطابقة لبحثك")
                        </td>
                    </tr>
                }
                else
                {
                    var i = (Model.Page - 1) * Model.PageSize + 1;
                    foreach (var s in Model.Suppliers)
                    {
                        <tr class="@(s.IsActive ? "" : "table-secondary")">
                            <td class="text-muted num">@(i++)</td>
                            <td class="fw-bold">
                                <a asp-action="Details" asp-route-id="@s.Id"
                                   class="text-decoration-none">@s.Name</a>
                            </td>
                            <td class="num" dir="ltr">@s.Phone</td>
                            <td>@(string.IsNullOrWhiteSpace(s.ContactPerson) ? "—" : s.ContactPerson)</td>
                            <td class="num">@s.OrderCount</td>
                            <td class="num">
                                @if (s.OpenOrderCount > 0)
                                {
                                    <span class="badge badge-soft-orange num">@s.OpenOrderCount</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            @if (canSeeCost)
                            {
                                <td class="num fw-bold">@s.TotalPurchased.ToString("N2")</td>
                            }
                            <td class="num small text-muted">
                                @(s.LastOrderAt?.ToString("yyyy-MM-dd") ?? "—")
                            </td>
                            <td>
                                @if (s.IsActive)
                                {
                                    <span class="badge badge-soft-green">مفعل</span>
                                }
                                else
                                {
                                    <span class="badge badge-soft-gray">معطَّل</span>
                                }
                            </td>
                            <td>
                                <a class="btn btn-sm btn-outline-secondary"
                                   asp-action="Details" asp-route-id="@s.Id">
                                    <i class="bi bi-receipt"></i> كشف الحساب
                                </a>
                                @if (canManage)
                                {
                                    <a class="btn btn-sm btn-outline-primary"
                                       asp-action="Edit" asp-route-id="@s.Id">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form asp-action="ToggleActive" asp-route-id="@s.Id"
                                          method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit"
                                                class="btn btn-sm btn-outline-@(s.IsActive ? "warning" : "success")"
                                                title="@(s.IsActive ? "تعطيل" : "تفعيل")">
                                            <i class="bi bi-@(s.IsActive ? "pause" : "play")"></i>
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination justify-content-center">
            @for (var p = 1; p <= Model.TotalPages; p++)
            {
                <li class="page-item @(p == Model.Page ? "active" : "")">
                    <a class="page-link num" asp-action="Index" asp-route-page="@p"
                       asp-route-q="@Model.Query"
                       asp-route-includeInactive="@Model.IncludeInactive">@p</a>
                </li>
            }
        </ul>
    </nav>
}
