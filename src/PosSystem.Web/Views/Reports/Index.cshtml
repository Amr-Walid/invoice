@model PosSystem.Web.Models.ViewModels.ReportResultVm
@{
    ViewData["Title"] = "تقرير المبيعات";
    ViewData["FilterController"] = "Reports";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <h1 class="page-title mb-0">
        <i class="bi bi-graph-up"></i> تقرير المبيعات — @Model.Filter.PeriodLabel
    </h1>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-success"
           asp-action="ExportCsv"
           asp-route-Period="@((int)Model.Filter.Period)"
           asp-route-From="@(Model.Filter.From?.ToString("yyyy-MM-dd"))"
           asp-route-To="@(Model.Filter.To?.ToString("yyyy-MM-dd"))"
           asp-route-AgentId="@Model.Filter.AgentId"
           asp-route-Search="@Model.Filter.Search">
            <i class="bi bi-file-earmark-excel"></i> تصدير CSV
        </a>
        <a class="btn btn-outline-primary" asp-action="TopProducts"
           asp-route-Period="@((int)Model.Filter.Period)">
            <i class="bi bi-trophy"></i> الأكثر مبيعًا
        </a>
    </div>
</div>

@await Html.PartialAsync("_ReportFilter", Model)
@await Html.PartialAsync("_ReportSummary", Model.Summary)

<div class="table-wrap">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>رقم الفاتورة</th>
                    <th>التاريخ والوقت</th>
                    <th>المندوب</th>
                    <th>العميل</th>
                    <th>الأصناف</th>
                    <th>الفرعي</th>
                    <th>الخصم</th>
                    <th>الإجمالي</th>
                    <th style="width:120px"></th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Invoices.Any())
                {
                    <tr>
                        <td colspan="9" class="empty-state">
                            <i class="bi bi-inbox"></i>
                            لا توجد فواتير في هذه الفترة
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var inv in Model.Invoices)
                    {
                        <tr>
                            <td><strong class="num">@inv.InvoiceNumber</strong></td>
                            <td class="num">@inv.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>
                                <span class="badge badge-soft-blue">@(inv.Agent?.FullName ?? "—")</span>
                            </td>
                            <td>@(string.IsNullOrWhiteSpace(inv.CustomerName) ? "—" : inv.CustomerName)</td>
                            <td class="num">@inv.Items.Count</td>
                            <td class="num">@inv.SubTotal.ToString("N2")</td>
                            <td>
                                @if (inv.DiscountAmount > 0)
                                {
                                    <span class="badge badge-soft-red num">
                                        @inv.DiscountPercentage.ToString("0.##")% (@inv.DiscountAmount.ToString("N2"))
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td><strong class="num text-success">@inv.Total.ToString("N2")</strong></td>
                            <td>
                                <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@inv.Id">
                                    <i class="bi bi-eye"></i> تفاصيل
                                </a>
                                <a class="btn btn-sm btn-outline-secondary" asp-controller="Pos"
                                   asp-action="Receipt" asp-route-id="@inv.Id" target="_blank" title="طباعة">
                                    <i class="bi bi-printer"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination justify-content-center flex-wrap">
            @for (var p = 1; p <= Model.TotalPages; p++)
            {
                <li class="page-item @(p == Model.Filter.Page ? "active" : "")">
                    <a class="page-link num"
                       asp-action="Index"
                       asp-route-Period="@((int)Model.Filter.Period)"
                       asp-route-From="@(Model.Filter.From?.ToString("yyyy-MM-dd"))"
                       asp-route-To="@(Model.Filter.To?.ToString("yyyy-MM-dd"))"
                       asp-route-AgentId="@Model.Filter.AgentId"
                       asp-route-Search="@Model.Filter.Search"
                       asp-route-Page="@p">@p</a>
                </li>
            }
        </ul>
    </nav>
}
