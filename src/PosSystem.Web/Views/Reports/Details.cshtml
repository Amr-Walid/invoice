@model PosSystem.Web.Models.Entities.Invoice
@{
    ViewData["Title"] = "تفاصيل الفاتورة " + Model.InvoiceNumber;
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <h1 class="page-title mb-0">
        <i class="bi bi-receipt"></i> تفاصيل الفاتورة
    </h1>
    <a class="btn btn-outline-secondary" asp-action="Index">
        <i class="bi bi-arrow-right"></i> رجوع للتقارير
    </a>
</div>

@await Html.PartialAsync("_InvoiceDetails", Model)
