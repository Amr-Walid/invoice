@model PosSystem.Web.Models.Entities.Warehouse
@{
    ViewData["Title"] = "تعديل مخزن";
}

<h1 class="page-title"><i class="bi bi-pencil-square"></i> تعديل المخزن «@Model.Name»</h1>

<div class="row">
    <div class="col-lg-9">
        <div class="card">
            <div class="card-body">
                <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="CreatedAt" />
                    @await Html.PartialAsync("_WarehouseForm", Model)

                    <div class="mt-4">
                        <button type="submit" class="btn btn-brand touch-btn px-4">
                            <i class="bi bi-check-lg"></i> حفظ التعديلات
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary touch-btn px-4">إلغاء</a>
                        <a asp-action="Stock" asp-route-id="@Model.Id"
                           class="btn btn-outline-secondary touch-btn px-4">
                            <i class="bi bi-box-seam"></i> مخزون هذا المخزن
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts { @await Html.PartialAsync("_ValidationScriptsPartial") }
