@model PosSystem.Web.Models.Entities.Coupon

<div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3"></div>

<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="Code" class="form-label"></label>
        <input asp-for="Code" class="form-control num" dir="ltr" placeholder="SAVE20"
               style="text-transform:uppercase" autofocus />
        <span asp-validation-for="Code" class="text-danger"></span>
        <small class="text-muted">يُحفظ بحروف كبيرة تلقائيًا</small>
    </div>

    <div class="col-md-6">
        <label asp-for="DiscountPercentage" class="form-label"></label>
        <div class="input-group">
            <input asp-for="DiscountPercentage" class="form-control num" dir="ltr"
                   type="number" step="0.01" min="0.01" max="100" />
            <span class="input-group-text">%</span>
        </div>
        <span asp-validation-for="DiscountPercentage" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="StartDate" class="form-label"></label>
        <input asp-for="StartDate" class="form-control num" type="date" />
        <span asp-validation-for="StartDate" class="text-danger"></span>
        <small class="text-muted">اتركه فارغًا لبدء فوري</small>
    </div>

    <div class="col-md-4">
        <label asp-for="EndDate" class="form-label"></label>
        <input asp-for="EndDate" class="form-control num" type="date" />
        <span asp-validation-for="EndDate" class="text-danger"></span>
        <small class="text-muted">اتركه فارغًا لصلاحية دائمة</small>
    </div>

    <div class="col-md-4">
        <label asp-for="MaxUsageCount" class="form-label"></label>
        <input asp-for="MaxUsageCount" class="form-control num" dir="ltr" type="number" min="1" />
        <span asp-validation-for="MaxUsageCount" class="text-danger"></span>
        <small class="text-muted">اتركه فارغًا لاستخدام غير محدود</small>
    </div>

    <div class="col-12">
        <div class="form-check">
            <input asp-for="IsActive" class="form-check-input" />
            <label asp-for="IsActive" class="form-check-label">مفعل (قابل للاستخدام في نقطة البيع)</label>
        </div>
    </div>
</div>
