@model List<PosSystem.Web.Models.Entities.Coupon>
@{
    ViewData["Title"] = "أكواد الخصم";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <h1 class="page-title mb-0"><i class="bi bi-ticket-perforated"></i> أكواد الخصم</h1>
    <a class="btn btn-brand touch-btn" asp-action="Create">
        <i class="bi bi-plus-lg"></i> كود خصم جديد
    </a>
</div>

<div class="table-wrap">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th style="width:50px">#</th>
                    <th>الكود</th>
                    <th style="width:110px">نسبة الخصم</th>
                    <th style="width:100px">الحالة</th>
                    <th>الصلاحية</th>
                    <th style="width:130px">الاستخدام</th>
                    <th style="width:250px"></th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="empty-state">
                            <i class="bi bi-ticket-perforated"></i> لا توجد أكواد خصم
                        </td>
                    </tr>
                }
                else
                {
                    var i = 1;
                    foreach (var c in Model)
                    {
                        <tr>
                            <td class="text-muted num">@(i++)</td>
                            <td>
                                <strong class="num barcode-text" style="font-size:1.02rem">@c.Code</strong>
                            </td>
                            <td>
                                <span class="badge bg-danger num" style="font-size:.92rem">
                                    @c.DiscountPercentage.ToString("0.##")%
                                </span>
                            </td>
                            <td>
                                <span class="badge @(c.IsActive ? "badge-soft-green" : "badge-soft-red")">
                                    @(c.IsActive ? "مفعل" : "معطل")
                                </span>
                            </td>
                            <td style="font-size:.85rem">
                                @if (c.StartDate.HasValue || c.EndDate.HasValue)
                                {
                                    <span class="num">
                                        @(c.StartDate?.ToString("yyyy-MM-dd") ?? "—")
                                        ←
                                        @(c.EndDate?.ToString("yyyy-MM-dd") ?? "—")
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">بلا حدود زمنية</span>
                                }
                            </td>
                            <td>
                                <span class="num">@c.UsedCount</span>
                                @if (c.MaxUsageCount.HasValue)
                                {
                                    <span class="text-muted num">/ @c.MaxUsageCount</span>
                                }
                                else
                                {
                                    <span class="text-muted">/ ∞</span>
                                }
                            </td>
                            <td>
                                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@c.Id">
                                    <i class="bi bi-pencil"></i> تعديل
                                </a>
                                <form asp-action="ToggleActive" asp-route-id="@c.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm @(c.IsActive ? "btn-outline-warning" : "btn-outline-success")">
                                        <i class="bi @(c.IsActive ? "bi-pause-circle" : "bi-play-circle")"></i>
                                        @(c.IsActive ? "تعطيل" : "تفعيل")
                                    </button>
                                </form>
                                <form asp-action="Delete" asp-route-id="@c.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('هل تريد بالتأكيد حذف الكود «@c.Code»؟');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<p class="text-muted mt-2" style="font-size:.84rem">
    <i class="bi bi-info-circle"></i>
    الكود المستخدم في فواتير سابقة يتم <strong>تعطيله</strong> بدلًا من حذفه، حفاظًا على بيانات الفواتير.
</p>
