@model PosSystem.Web.Models.Entities.Coupon
@{
    ViewData["Title"] = "تعديل كود الخصم";
}

<h1 class="page-title"><i class="bi bi-pencil-square"></i> تعديل كود الخصم</h1>

<div class="card">
    <div class="card-body">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="CreatedAt" />
            <input type="hidden" asp-for="UsedCount" />

            @await Html.PartialAsync("_CouponForm", Model)

            <hr class="my-4">
            <button type="submit" class="btn btn-brand touch-btn px-4">
                <i class="bi bi-check-lg"></i> حفظ التعديلات
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary touch-btn px-4">إلغاء</a>
        </form>
    </div>
</div>

@section Scripts { @await Html.PartialAsync("_ValidationScriptsPartial") }
