@model PosSystem.Web.Models.ViewModels.PurchaseOrderListVm
@using PosSystem.Web.Models.Entities
@{
    ViewData["Title"] = "أوامر بانتظار التوريد";
    var canManage = (bool)(ViewBag.CanManage ?? false);
    var locked = (bool)(ViewBag.LockedWarehouse ?? false);
    var warehouses = ViewBag.Warehouses as List<Warehouse> ?? new List<Warehouse>();
    var selectedWarehouse = warehouses.FirstOrDefault(w => w.Id == Model.WarehouseId);

    var overdue = Model.Orders.Count(o => o.IsOverdue);
    var pieces = Model.Orders.Sum(o => o.TotalRemaining);
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <h1 class="page-title mb-0">
        <i class="bi bi-hourglass-split"></i> بانتظار التوريد
        @if (selectedWarehouse is not null)
        {
            <span class="badge badge-soft-gray">@selectedWarehouse.Name</span>
        }
    </h1>
    <div class="d-flex gap-2 flex-wrap">
        @if (canManage)
        {
            <a class="btn btn-brand touch-btn" asp-action="Create">
                <i class="bi bi-plus-lg"></i> أمر شراء جديد
            </a>
        }
        <a class="btn btn-outline-secondary touch-btn" asp-action="Index">
            <i class="bi bi-list-ul"></i> كل الأوامر
        </a>
    </div>
</div>

@* هذه شاشة العمل اليومي لأمين المخزن: ما ينتظر توريدًا الآن، بلا ضجيج
   الأوامر المكتملة والملغاة *@
<div class="alert alert-info">
    <i class="bi bi-info-circle"></i>
    هذه الأوامر مُعتمدة ومُرسَلة للمورد، ولم تُضَف كمياتها للمخزون بعد —
    لن تُضاف إلا بتسجيل الاستلام.
</div>

@if (overdue > 0)
{
    <div class="alert alert-danger">
        <i class="bi bi-exclamation-triangle"></i>
        <strong class="num">@overdue</strong> أمر تجاوز تاريخ التوريد المتوقع — تابع المورد.
    </div>
}

<div class="row g-3 mb-3">
    <div class="col-6 col-lg-4">
        <div class="card"><div class="card-body py-3">
            <div class="text-muted small">أوامر مفتوحة</div>
            <div class="fs-4 fw-bold num">@Model.Orders.Count</div>
        </div></div>
    </div>
    <div class="col-6 col-lg-4">
        <div class="card"><div class="card-body py-3">
            <div class="text-muted small">قطع منتظرة</div>
            <div class="fs-4 fw-bold num @(pieces > 0 ? "text-warning" : "")">@pieces</div>
        </div></div>
    </div>
    <div class="col-12 col-lg-4">
        <div class="card"><div class="card-body py-3">
            <div class="text-muted small">متأخرة عن الموعد</div>
            <div class="fs-4 fw-bold num @(overdue > 0 ? "text-danger" : "")">@overdue</div>
        </div></div>
    </div>
</div>

@if (!locked && warehouses.Count > 1)
{
    @* المُبدِّل يظهر للمدير وحده: أمين المخزن مُقيَّد بمخزنه، والخادم يتجاهل
       أي معرّف آخر يُرسله، فعرض المُبدِّل له وعد لا يُوفى *@
    <div class="card mb-3">
        <div class="card-body py-3">
            <form method="get" asp-action="Open" class="row g-2 align-items-end">
                <div class="col-md-4">
                    <label class="form-label small text-muted">المخزن المستقبِل</label>
                    <select name="warehouseId" class="form-select" onchange="this.form.submit()">
                        <option value="">كل المخازن</option>
                        @foreach (var w in warehouses)
                        {
                            <option value="@w.Id" selected="@(Model.WarehouseId == w.Id)">@w.Name</option>
                        }
                    </select>
                </div>
            </form>
        </div>
    </div>
}

@await Html.PartialAsync("_PurchaseTable", Model.Orders,
    new ViewDataDictionary(ViewData)
    {
        ["EmptyText"] = "لا توجد أوامر بانتظار التوريد — كل ما اعتُمد وصل واستُلم"
    })
