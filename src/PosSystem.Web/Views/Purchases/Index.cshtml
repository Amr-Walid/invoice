@model PosSystem.Web.Models.ViewModels.PurchaseOrderListVm
@using PosSystem.Web.Models.Entities
@{
    ViewData["Title"] = "أوامر الشراء";
    var canManage = (bool)(ViewBag.CanManage ?? false);
    var canSeeCost = (bool)(ViewBag.CanSeeCost ?? false);
    var suppliers = ViewBag.Suppliers as List<Supplier> ?? new List<Supplier>();
    var warehouses = ViewBag.Warehouses as List<Warehouse> ?? new List<Warehouse>();
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <h1 class="page-title mb-0"><i class="bi bi-cart"></i> أوامر الشراء</h1>
    <div class="d-flex gap-2 flex-wrap">
        @if (canManage)
        {
            <a class="btn btn-brand touch-btn" asp-action="Create">
                <i class="bi bi-plus-lg"></i> أمر شراء جديد
            </a>
        }
        <a class="btn btn-outline-primary touch-btn" asp-action="Open">
            <i class="bi bi-hourglass-split"></i> بانتظار التوريد
            @if (Model.OpenCount > 0)
            {
                <span class="badge bg-warning text-dark num">@Model.OpenCount</span>
            }
        </a>
        <a class="btn btn-outline-secondary touch-btn" asp-action="Receipts">
            <i class="bi bi-box-seam"></i> أذون الاستلام
        </a>
        @if (canManage)
        {
            <a class="btn btn-outline-secondary touch-btn" asp-action="Report">
                <i class="bi bi-graph-up"></i> تقرير المشتريات
            </a>
        }
    </div>
</div>

@if (Model.OverdueCount > 0)
{
    <div class="alert alert-danger">
        <i class="bi bi-exclamation-triangle"></i>
        <strong class="num">@Model.OverdueCount</strong> أمر تجاوز تاريخ التوريد المتوقع ولم يكتمل —
        راجع الموردين المتأخرين.
    </div>
}

<div class="row g-3 mb-3">
    <div class="col-6 col-lg-3">
        <div class="card"><div class="card-body py-3">
            <div class="text-muted small">عدد الأوامر</div>
            <div class="fs-4 fw-bold num">@Model.TotalCount</div>
        </div></div>
    </div>
    @if (canSeeCost)
    {
        <div class="col-6 col-lg-3">
            <div class="card"><div class="card-body py-3">
                @* المبلغ لكل نتائج الفلتر لا للصفحة المعروضة: «إجمالي مشتريات
                   الفترة» يجب أن يكون رقم الفترة كاملة وإلا كان مضللًا *@
                <div class="text-muted small">إجمالي المشتريات</div>
                <div class="fs-4 fw-bold num">@Model.GrandTotal.ToString("N2")</div>
                <div class="small text-muted">بلا الملغاة</div>
            </div></div>
        </div>
    }
    <div class="col-6 col-lg-3">
        <div class="card"><div class="card-body py-3">
            <div class="text-muted small">بانتظار التوريد</div>
            <div class="fs-4 fw-bold num @(Model.OpenCount > 0 ? "text-warning" : "")">@Model.OpenCount</div>
        </div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card"><div class="card-body py-3">
            <div class="text-muted small">قطع لم تصل بعد</div>
            <div class="fs-4 fw-bold num @(Model.PiecesPending > 0 ? "text-danger" : "")">@Model.PiecesPending</div>
        </div></div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body py-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small text-muted">بحث</label>
                <input type="search" name="q" value="@Model.Query" class="form-control"
                       placeholder="رقم الأمر، المورد، صنف، باركود…" />
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted">المورد</label>
                <select name="supplierId" class="form-select">
                    <option value="">الكل</option>
                    @foreach (var s in suppliers)
                    {
                        <option value="@s.Id" selected="@(Model.SupplierId == s.Id)">@s.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted">المخزن</label>
                <select name="warehouseId" class="form-select">
                    <option value="">الكل</option>
                    @foreach (var w in warehouses)
                    {
                        <option value="@w.Id" selected="@(Model.WarehouseId == w.Id)">@w.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted">الحالة</label>
                <select name="status" class="form-select">
                    <option value="">الكل</option>
                    @foreach (var st in Enum.GetValues<PurchaseStatus>())
                    {
                        <option value="@((int)st)" selected="@(Model.Status == st)">
                            @PurchaseStatusLabel.Of(st)
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <div class="row g-1">
                    <div class="col-6">
                        <label class="form-label small text-muted">من</label>
                        <input type="date" name="from" class="form-control num"
                               value="@Model.From?.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="col-6">
                        <label class="form-label small text-muted">إلى</label>
                        <input type="date" name="to" class="form-control num"
                               value="@Model.To?.AddDays(-1).ToString("yyyy-MM-dd")" />
                    </div>
                </div>
            </div>
            <div class="col-12 d-flex gap-2">
                <button type="submit" class="btn btn-brand touch-btn">
                    <i class="bi bi-funnel"></i> تطبيق
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary touch-btn">إلغاء الفلتر</a>
            </div>
        </form>
    </div>
</div>

@await Html.PartialAsync("_PurchaseTable", Model.Orders,
    new ViewDataDictionary(ViewData) { ["EmptyText"] = "لا توجد أوامر شراء مطابقة" })

@if (Model.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination justify-content-center">
            @for (var p = 1; p <= Model.TotalPages; p++)
            {
                <li class="page-item @(p == Model.Page ? "active" : "")">
                    <a class="page-link num" asp-action="Index" asp-route-page="@p"
                       asp-route-q="@Model.Query" asp-route-supplierId="@Model.SupplierId"
                       asp-route-warehouseId="@Model.WarehouseId"
                       asp-route-status="@Model.Status">@p</a>
                </li>
            }
        </ul>
    </nav>
}
