@model PosSystem.Web.Models.ViewModels.CustomerListVm
@{
    ViewData["Title"] = "العملاء";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <h1 class="page-title mb-0">
        <i class="bi bi-people-fill"></i> العملاء
        <span class="badge badge-soft-blue num">@Model.TotalCount</span>
    </h1>
</div>

@*
    لا يوجد زر «إضافة عميل» عن قصد: العميل يُنشأ تلقائيًا بمجرد كتابة رقم
    هاتفه في الفاتورة، فلا حاجة لإدخال مزدوج. هذا التنبيه يشرح ذلك للمستخدم.
*@
<div class="alert alert-light border d-flex align-items-center gap-2" style="font-size:.88rem">
    <i class="bi bi-info-circle text-primary"></i>
    <span>
        يُضاف العميل تلقائيًا عند كتابة رقم هاتفه في الفاتورة، وتُربط كل فواتيره
        برقمه — حتى لو كُتب الرقم بصيغة مختلفة (مثل <span class="num">+20</span> أو بمسافات).
    </span>
</div>

<form class="filter-bar" method="get" asp-action="Index">
    <div class="row g-2 align-items-end">
        <div class="col-12 col-md-6">
            <label class="form-label">بحث بالاسم أو رقم الهاتف</label>
            <input type="text" name="q" class="form-control" value="@Model.Query"
                   placeholder="اسم العميل أو رقم هاتفه" autofocus />
        </div>
        <div class="col-6 col-md-2">
            <button type="submit" class="btn btn-brand w-100">
                <i class="bi bi-search"></i> بحث
            </button>
        </div>
        @if (!string.IsNullOrWhiteSpace(Model.Query))
        {
            <div class="col-6 col-md-2">
                <a class="btn btn-outline-secondary w-100" asp-action="Index">
                    <i class="bi bi-x-circle"></i> إلغاء
                </a>
            </div>
        }
    </div>
</form>

<div class="table-wrap">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>اسم العميل</th>
                    <th>رقم الهاتف</th>
                    <th class="text-center">الفواتير</th>
                    <th class="text-center">المرتجعات</th>
                    <th>إجمالي المشتريات</th>
                    <th>آخر شراء</th>
                    <th style="width:110px"></th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Customers.Any())
                {
                    <tr>
                        <td colspan="7" class="empty-state">
                            <i class="bi bi-person-x"></i>
                            @(string.IsNullOrWhiteSpace(Model.Query)
                                ? "لا يوجد عملاء بعد — سيظهر العميل هنا بعد أول فاتورة تُكتب برقم هاتفه"
                                : "لا يوجد عميل مطابق لبحثك")
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var c in Model.Customers)
                    {
                        <tr>
                            <td>
                                <strong>@c.Name</strong>
                                @if (!c.IsActive)
                                {
                                    <span class="badge badge-soft-gray">غير مفعل</span>
                                }
                            </td>
                            <td>
                                <a href="tel:@c.Phone" class="num text-decoration-none">
                                    <i class="bi bi-telephone"></i> @c.Phone
                                </a>
                            </td>
                            <td class="text-center">
                                <span class="badge badge-soft-blue num">@c.InvoiceCount</span>
                            </td>
                            <td class="text-center">
                                @if (c.ReturnCount > 0)
                                {
                                    <span class="badge badge-soft-orange num">@c.ReturnCount</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td><strong class="num text-success">@c.TotalSpent.ToString("N2")</strong></td>
                            <td class="num">
                                @(c.LastPurchase?.ToString("yyyy-MM-dd HH:mm") ?? "—")
                            </td>
                            <td>
                                <a class="btn btn-sm btn-outline-primary"
                                   asp-action="Details" asp-route-id="@c.Id">
                                    <i class="bi bi-eye"></i> تفاصيل
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination justify-content-center">
            @for (var p = 1; p <= Model.TotalPages; p++)
            {
                <li class="page-item @(p == Model.Page ? "active" : "")">
                    <a class="page-link num" asp-action="Index"
                       asp-route-q="@Model.Query" asp-route-page="@p">@p</a>
                </li>
            }
        </ul>
    </nav>
}
