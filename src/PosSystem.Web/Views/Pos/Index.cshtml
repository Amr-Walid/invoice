@model PosSystem.Web.Models.ViewModels.AgentDashboardVm
@{
    ViewData["Title"] = "الرئيسية";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <h1 class="page-title mb-0">
        <i class="bi bi-house-door-fill"></i> أهلاً @Model.AgentName
    </h1>
    <span class="text-muted num" style="font-size:.9rem">
        <i class="bi bi-calendar3"></i> @DateTime.Now.ToString("yyyy-MM-dd")
    </span>
</div>

<!-- ============ المربعات الثلاثة الكبيرة ============ -->
<div class="agent-tiles mb-4">
    <button type="button" class="tile tile-invoice" id="btnNewInvoice">
        <span class="tile-key">F2</span>
        <i class="bi bi-receipt-cutoff tile-icon"></i>
        <span class="tile-title">فاتورة جديدة</span>
        <span class="tile-sub">امسح الباركود وأتمم البيع في ثوانٍ</span>
    </button>

    <a class="tile tile-reports" asp-controller="AgentReports" asp-action="Index">
        <i class="bi bi-bar-chart-line-fill tile-icon"></i>
        <span class="tile-title">التقارير</span>
        <span class="tile-sub">استعرض فواتيرك ومبيعاتك</span>
    </a>

    @*
        المربع الثالث. اللون البرتقالي يميّزه فورًا عن البيع (أخضر) والتقارير
        (أزرق) قبل قراءة النص — يهمّ في شاشة لمس سريعة.
    *@
    <a class="tile tile-returns" asp-controller="Returns" asp-action="Index">
        <span class="tile-key">F3</span>
        <i class="bi bi-arrow-counterclockwise tile-icon"></i>
        <span class="tile-title">مرتجع</span>
        <span class="tile-sub">أرجع فاتورة أو صنفًا وأعِد الكمية للمخزون</span>
    </a>
</div>

<!-- ============ إحصائيات سريعة ============ -->
<div class="stat-grid">
    <div class="stat green">
        <div class="stat-label"><i class="bi bi-receipt"></i> فواتير اليوم</div>
        <div class="stat-value num">@Model.TodayInvoices</div>
    </div>
    <div class="stat">
        <div class="stat-label"><i class="bi bi-cash-coin"></i> مبيعات اليوم</div>
        <div class="stat-value num">@Model.TodaySales.ToString("N2")</div>
    </div>
    <div class="stat purple">
        <div class="stat-label"><i class="bi bi-calendar-month"></i> فواتير الشهر</div>
        <div class="stat-value num">@Model.MonthInvoices</div>
    </div>
    <div class="stat orange">
        <div class="stat-label"><i class="bi bi-graph-up-arrow"></i> مبيعات الشهر</div>
        <div class="stat-value num">@Model.MonthSales.ToString("N2")</div>
    </div>
</div>

@await Html.PartialAsync("_PosModal")

@section Scripts {
    @* مكتبة قراءة الباركود بصريًا — محليًا حتى يعمل النظام بدون إنترنت *@
    <script src="~/lib/zxing/zxing.min.js" asp-append-version="true"></script>
    <script src="~/js/camera-scanner.js" asp-append-version="true"></script>
    <script src="~/js/pos.js" asp-append-version="true"></script>
}
